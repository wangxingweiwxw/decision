# ---- Secrets: never commit ----
.env
.env.*
!.env.example
*.key
*.pem
secrets.json

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# ---- Benchmark outputs (regenerate locally; may contain run-specific data) ----
decision-benchmark/data/pubmedqa/
decision-benchmark/.env

# ---- Licensed system fonts: do NOT redistribute ----
