# locally at render time; see video/README.md for the setup step.
video/intro/fonts/
*.ttc
*.ttf
*.otf

# ---- Large / regenerable media ----
video/intro/audio/*.wav
video/intro/qa/
video/**/renders/
!video/intro/renders/.gitkeep

# ---- Agent / editor / OS noise ----
.box-agent/
.box-agent-scratch/
work/pdf-report/mpl-cache/
work/pdf-report/fourway/
