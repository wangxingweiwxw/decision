# Copy to .env, or use PowerShell $env:NAME = "value".
# Real keys are never bundled or written into reports.
DASHSCOPE_API_KEY=
BAILIAN_WORKSPACE_ID=
BAILIAN_REGION=cn-beijing
BAILIAN_MODEL=decision-model-preview
OPENROUTER_API_KEY=
OPENROUTER_MODEL=microsoft/microsoft-decision-1
# Optional: pin an upstream provider by its OpenRouter slug.
# Routing options are used only if this variable is nonempty.
OPENROUTER_PROVIDER=

# Qwen3.5-9B baseline; same OPENROUTER_API_KEY, BF16 endpoint required
QWEN_PROVIDER=deepinfra

# TypeSafe Jev via OpenRouter (System One decision model). Uses the SAME OPENROUTER_API_KEY above;
# no TypeSafe account or waitlist. Decisions API: POST /api/alpha/decisions, model slug typesafe/jev-1.13.
JEV_MODEL=typesafe/jev-1.13
# Optional: pin an upstream provider slug for Jev; routing only applied if nonempty.
JEV_PROVIDER=
